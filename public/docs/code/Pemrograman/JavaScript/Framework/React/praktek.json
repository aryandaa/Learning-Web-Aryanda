{"schemaVersion":1,"type":"code-folder","folder":"praktek","path":"Pemrograman/JavaScript/Framework/React/praktek","parentPath":"Pemrograman/JavaScript/Framework/React","outputPath":"code/Pemrograman/JavaScript/Framework/React/praktek","files":[{"name":"properti.html","path":"Pemrograman/JavaScript/Framework/React/praktek/properti.html","extension":".html","language":"html","size":1313,"content":"<!DOCTYPE html>\n<html>\n  <head>\n    <title>Belajar React</title>\n    <script src=\"https://unpkg.com/react@18/umd/react.development.js\"></script>\n    <script src=\"https://unpkg.com/react-dom@18/umd/react-dom.development.js\"></script>\n    <script src=\"https://unpkg.com/@babel/standalone/babel.min.js\"></script>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n\n    <!-- Coba Prakteknya di sini -->\n    <script type=\"text/markdown\" id=\"source\">\n      function SayHello(props) {\n          const nama = props.nama;\n          const asal = props.asal;\n          return (\n            <div>Hello nama ku {nama}, asal ku dari {asal}</div>\n          );\n      }\n\n      // Cara menampilkannya ke layar\n      function App() {\n        return (\n          <div>\n            <SayHello nama=\"yanda\" asal=\"bjm\"/>\n            <SayHello nama=\"adit\" asal=\"kandangan\"/>\n            <SayHello nama=\"andika\" asal=\"alalak\"/>\n          </div>\n        );\n      }\n\n      const root = ReactDOM.createRoot(document.getElementById('root'));\n      root.render(<App />);\n    </script>\n\n    <script>\n      // Boilerplate untuk menjalankan Babel di browser\n      const script = document.getElementById('source');\n      const compiled = Babel.transform(script.innerHTML, { presets: ['react'] }).code;\n      eval(compiled);\n    </script>\n  </body>\n</html>","contentHash":"sha256:5043835f9dd5e31595e25013efbefc1960c31fdb2d21b432ec5c0c74d8682eb3"}]}