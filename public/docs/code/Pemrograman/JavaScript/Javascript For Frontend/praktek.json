{"schemaVersion":1,"type":"code-folder","folder":"praktek","path":"Pemrograman/JavaScript/Javascript For Frontend/praktek","parentPath":"Pemrograman/JavaScript/Javascript For Frontend","outputPath":"code/Pemrograman/JavaScript/Javascript For Frontend/praktek","files":[{"name":"event.html","path":"Pemrograman/JavaScript/Javascript For Frontend/praktek/event.html","extension":".html","language":"html","size":1471,"content":"<!DOCTYPE html>\n<html>\n<head>\n  <title>Event World</title>\n  \n  <style>\n    .contents {\n      position: fixed;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      border: 2px solid black;\n      padding: 15px;\n    }\n    \n    #generateButton {\n      margin-top: 5px;\n      margin-bottom: 15px;;\n    }\n  </style>\n</head>\n<body>\n<div class=\"contents\" align=\"center\" hidden>\n  <button id=\"incrementButton\">Tekan Aku :</button>\n  <h3>Kamu sudah menekan tombol di atas sebanyak <span id=\"count\">0</span></h3>\n</div>\n\n<script>\n//Onload\nfunction welcome(){\n    alert('Sim salabim muncullah elemen-elemen HTML!');\n    const konten = document.querySelector('.contents');\n    konten.removeAttribute('hidden');\n}\n\n// Onclick\nfunction increment(){\n    document.getElementById('count').innerText++;\n\n    if (document.getElementById('count').innerText === 7) {\n    const hiddenMessage = document.createElement('h4');\n    hiddenMessage.innerText = 'Selamat! Anda menemukan hadiah tersembunyi...';\n    \n    const image = document.createElement('img');\n    image.setAttribute(\n        'src', \n        'https://raw.githubusercontent.com/dicodingacademy/a315-web-pemula-labs/shared-files/catto.jpg',\n    );\n    \n    const contents = document.querySelector('.contents');\n    contents.appendChild(hiddenMessage).appendChild(image);\n    }\n}\n\ndocument.getElementById('incrementButton').onclick = increment;\ndocument.body.onload = welcome();\n\n</script>\n</body>\n</html>\n\n","contentHash":"sha256:893c2f99db32f7984e2abca0784539b3cdba18f14dc53cf3749af2ad6ca1cd87"},{"name":"EventHandlerInline.html","path":"Pemrograman/JavaScript/Javascript For Frontend/praktek/EventHandlerInline.html","extension":".html","language":"html","size":1440,"content":"<!DOCTYPE html>\n<html>\n<head>\n  <title>Event World</title>\n  <style>\n    .contents {\n      position: fixed;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      border: 2px solid black;\n      padding: 15px;\n    }\n    \n    #generateButton {\n      margin-top: 5px;\n      margin-bottom: 15px;;\n    }\n  </style>\n</head>\n<body onload=\"welcome()\">\n<div class=\"contents\" align=\"center\" hidden>\n  <button id=\"incrementButton\" onclick=\"increment()\">Tekan Aku :</button>\n  <h3>Kamu sudah menekan tombol di atas sebanyak <span id=\"count\">0</span></h3>\n</div>\n\n<script>\n  function increment() {\n    document.getElementById('count').innerText++;\n    \n    if (document.getElementById('count').innerText == 7) {\n      const hiddenMessage = document.createElement('h4');\n      hiddenMessage.innerText = 'Selamat! Anda menemukan hadiah tersembunyi...';\n      // const image = document.createElement('img');\n      // image.setAttribute('src', 'https://i.ibb.co/0V49VRZ/catto.jpg');\n      const contents = document.querySelector('.contents');\n      contents.appendChild(hiddenMessage).appendChild(image);\n    }\n  }\n  \n  function welcome() {\n    alert('Sim salabim muncullah elemen-elemen HTML!');\n    const contents = document.querySelector('.contents');\n    contents.removeAttribute('hidden');\n  }\n  \n  // document.getElementById('incrementButton').onclick = increment;\n  // document.body.onload = welcome;\n</script>\n</body>\n</html>","contentHash":"sha256:8e7e669be7902ce2616ee871b393f38abf91040fd43791bece7ed4b50e5b890d"},{"name":"EventListener.html","path":"Pemrograman/JavaScript/Javascript For Frontend/praktek/EventListener.html","extension":".html","language":"html","size":1477,"content":"<!DOCTYPE html>\n<html>\n<head>\n  <title>Event World</title>\n  <style>\n    .contents {\n      position: fixed;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      border: 2px solid black;\n      padding: 15px;\n    }\n    \n    #generateButton {\n      margin-top: 5px;\n      margin-bottom: 15px;;\n    }\n  </style>\n</head>\n<body>\n<div class=\"contents\" align=\"center\" hidden>\n  <button id=\"incrementButton\">Tekan Aku :</button>\n  <h3>Kamu sudah menekan tombol di atas sebanyak <span id=\"count\">0</span></h3>\n</div>\n\n<script>\n  function increment() {\n    document.getElementById('count').innerText++;\n    \n    if (document.getElementById('count').innerText == 7) {\n      const hiddenMessage = document.createElement('h4');\n      hiddenMessage.innerText = 'Selamat! Anda menemukan hadiah tersembunyi...';\n\n      const image = document.createElement('img');\n      image.setAttribute('src', 'https://i.ibb.co/0V49VRZ/catto.jpg');\n\n      const contents = document.querySelector('.contents');\n      contents.appendChild(hiddenMessage).appendChild(image);\n    }\n  }\n  \n  function welcome() {\n    alert('Sim salabim muncullah elemen-elemen HTML!');\n    const contents = document.querySelector('.contents');\n    contents.removeAttribute('hidden');\n  }\n  \n  // kita akan menulis kode menggunakan addEventListener di sini\nwindow.addEventListener('load', welcome);\ndocument.getElementById('incrementButton').addEventListener('click', increment);\n</script>\n</body>\n</html>","contentHash":"sha256:cd035c74da9bd23ab7e5ba4564c93cdfe9387c23399b49e8b05a095e583bec37"},{"name":"MakeCustomEvent.html","path":"Pemrograman/JavaScript/Javascript For Frontend/praktek/MakeCustomEvent.html","extension":".html","language":"html","size":1231,"content":"<!DOCTYPE html>\n<html>\n  <head>\n    <title>Event World</title>\n    <style>\n      .buttons {\n        position: fixed;\n        top: 50%;\n        left: 50%;\n        transform: translate(-50%, -50%);\n        border: 2px solid black;\n        padding: 15px;\n      }\n      .button {\n        margin: 8px;\n        height: 40px;\n      }\n    </style>\n  </head>\n  <body>\n    <div class=\"buttons\" align=\"center\">\n      <h3 id=\"caption\">Silakan tekan salah satu tombol di bawah...</h3>\n      <button class=\"button\" id=\"tombol\">Tombol Custom Event</button>\n    </div>\n\n\n    <script>\n      // tulis kode kamu di sini\n      const changeCaption = new Event('changeCaption');\n\n      window.addEventListener('load', function(){\n        const tombol = document.getElementById('tombol');\n        tombol.addEventListener('changeCaption', customEventHandler);\n        tombol.addEventListener('click', function(){\n          tombol.dispatchEvent(changeCaption);\n        })\n      })\n\n      function customEventHandler(ev) {\n        console.log('Event ' + ev.type + ' telah dijalankan');  \n        const caption = document.getElementById('caption');\n        caption.innerText = 'Anda telah membangkitkan custom event';\n      }\n    </script>\n\n  </body>\n</html>","contentHash":"sha256:0981bd1e7c8eaec797aa6153ccb6ffa8380ccd66d0247b451c8b67f13c797754"},{"name":"ManipulateThis.html","path":"Pemrograman/JavaScript/Javascript For Frontend/praktek/ManipulateThis.html","extension":".html","language":"html","size":2753,"content":"<!DOCTYPE html>\n<html>\n    <head>\n        <title>Welcome to Cube World!</title>\n          <style>\n            button {\n            width: 200px;\n            font-size: 15px;\n            margin: 8px;\n            padding: 3px;\n            }\n            \n            main {\n            margin: 2px;\n            }\n        </style>\n    </head>\n    <body>\n        <div align=\"center\">\n            <h2>Its Cube Time!</h2>\n            <img id=\"gambar\"\n                src=\"https://assets.cdn.dicoding.com/original/commons/homepage-dicoding-challenge-illustration.png\"\n                alt=\"Its a rubiks cube!\" width=\"150\" height=\"100\">\n            <p id=\"caption\"><b></b></p>\n            <div class=\"button-group\">\n                <div class=\"button\">\n                    <button>Sejarah</button>\n                </div>\n                <div class=\"button\">\n                    <button>Permainan</button>\n                </div>\n                <div class=\"button\">\n                    <button><i>Fun Fact</i></button>\n                </div>\n                <div class=\"button\">\n                    <button>Play (Coming Soon)</button>\n                </div>\n                <div class=\"button\">\n                    <button>Exit</button>\n                </div>\n            </div>\n        </div>\n        <hr size=\"2\" width=\"95%\" color=\"black\">\n        <div id=\"links\">\n            <p>Situs lainnya yang tidak kalah menarik:</p>\n            <ul>\n                <li><a href=\"http://www.dicoding.com\" id=\"dicodingLink\">Dicoding</a></li>\n                <li><a href=\"http://www.google.com\" id=\"googleLink\">Google</a></li>\n            </ul>\n        </div>\n    </body>\n</html>\n\n\n\n<script>\n// Prompt\n// let pesan = prompt(\"masukan pesan anda, nama\");\n// const nama = document.getElementById('caption').innerHTML = (\"Sudah siap \"+pesan+\" untuk memecahkan teka-teki permainan tersebut? \");\n\n\n// Mengubah ukuran gambar\nconst gambar = document.getElementById('gambar');\ngambar.setAttribute('width', 300);\ngambar.setAttribute('height', 215);\n\n// Mengubah Play (Coming Soon)\nconst buttons = document.querySelectorAll('.button')[3].children[0];\nbuttons.setAttribute('disabled', true);\n\n// Mengubah Text (innerTEXT)\nconst dicoding = document.getElementById('dicodingLink');\nconst google = document.getElementById('googleLink');\n\ndicoding.innerText = 'Belajar Programming di Dicoding';\ngoogle.innerText = 'Mencari sesuatu di Google';\n\n// Mengubah Konten (innerHtml)\ndicoding.innerHTML = '<i>Belajar Programming di Dicoding</i>';\ngoogle.innerHTML = '<i>Mencari sesuatu di Google</i>';\n\n// Mengubah style (Style.property)\nconst buttonstyle = document.getElementsByClassName('button');\nfor (const button of buttonstyle) {\n  button.children[0].style.borderRadius = '6px';\n}\n</script>\n\n","contentHash":"sha256:40299ea8ad091784d9f14b836b900c93c953b0987b2eee7e01badfdc205f8587"},{"name":"praktek2.html","path":"Pemrograman/JavaScript/Javascript For Frontend/praktek/praktek2.html","extension":".html","language":"html","size":783,"content":"<!DOCTYPE html>\n<html>\n    <head>\n        <title>Memasak Air</title>\n    </head>\n    <body>\n        <p id=\"name\">Langkah-langkah memasak air</p>\n        <ol id=\"daftar\">\n            <li id=\"awal\">Masukkan air ke dalam wadah.</li>\n            <li id=\"akhir\">Matikan kompor.</li>\n        </ol>\n        <hr size=\"2\" width=\"95%\" color=\"black\">\n    </body>\n</html>\n\n<script>\n//appendChild\nconst newElement = document.createElement('li');\nnewElement.innerText = 'Selamat Menikmati!'\nconst daftar = document.getElementById('daftar');\n\ndaftar.appendChild(newElement); \n\n//Insertbefore\nconst patokan = document.getElementById('awal');\nconst nyalakan = document.createElement('li');\nnyalakan.innerText = 'Nyalakan Kompornya terlebih dahulu';\n\n\ndaftar.insertBefore(nyalakan, patokan);\n</script>","contentHash":"sha256:4ede6e0abdd5579f6345f1b1f7fd29787412721844142b89d47cd916d604f4a5"}]}