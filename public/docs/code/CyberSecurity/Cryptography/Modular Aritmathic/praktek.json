{"schemaVersion":1,"type":"code-folder","folder":"praktek","path":"CyberSecurity/Cryptography/Modular Aritmathic/praktek","parentPath":"CyberSecurity/Cryptography/Modular Aritmathic","outputPath":"code/CyberSecurity/Cryptography/Modular Aritmathic/praktek","files":[{"name":"Extended GCD.py","path":"CyberSecurity/Cryptography/Modular Aritmathic/praktek/Extended GCD.py","extension":".py","language":"python","size":164,"content":"from sympy import gcdex, gcd\n\np = 26513\nq = 32321\n\nu, v, g = gcdex(p, q)\nprint(f\"u = {u}\\nv = {v}\")\nprint (f\"{p * u + q * v} hasilnya akan sama dengan {gcd(p, q)}\")","contentHash":"sha256:14f88a85101bc8c6342e0be63db48288aef14c0594ad8f49a050b35a8bcaf1ea"},{"name":"GCD.py","path":"CyberSecurity/Cryptography/Modular Aritmathic/praktek/GCD.py","extension":".py","language":"python","size":180,"content":"import math\n\n# Di python ada tools untuk menghitung nilai FPB ini yaitu gcd(a, b):\na = 66528\nb = 52920\nprint (math.gcd(a, b))\n\n# Contoh COprime\na = 11\nb = 17\nprint (math.gcd(a, b))","contentHash":"sha256:ca601a5abeb8106e287c29b7b81feace173ecd4769d4d93db26d3c911477328c"},{"name":"Legendre Symbol.py","path":"CyberSecurity/Cryptography/Modular Aritmathic/praktek/Legendre Symbol.py","extension":".py","language":"python","size":317,"content":"def Legendre (a, p):\n    p1 = p -1\n    p1 //= 2\n    a1 = pow(a, p1, p)\n\n    p2 = p1 + 1\n    if a1 == 1:\n        return f\"{a} adalah quadratic residue dari mod {p}\"\n    elif a1 == p1:\n        return f\"{a} adalah quadratic non-residue dari mod {p}\"\n    else:\n        return f\"{a} ≡ 0 (mod {p})\"\n\nprint(Legendre(7, 2))","contentHash":"sha256:58c19747940affc7eea525ea57683cb9c179e352537aeb2d719fcb27a74dfdb5"},{"name":"Modular Aritmathic.py","path":"CyberSecurity/Cryptography/Modular Aritmathic/praktek/Modular Aritmathic.py","extension":".py","language":"python","size":104,"content":"soal1 = 11 % 6\nsoal2 = 8146798528947 % 17\n\nprint (\"x:\", soal1)\nprint (\"y:\", soal2)\nprint (soal1 & soal2)","contentHash":"sha256:0f460b202a3ced7b7fa3f934ca275a97bc700700c8ae610f093903df127f55a2"},{"name":"Modular Aritmathic2.py","path":"CyberSecurity/Cryptography/Modular Aritmathic/praktek/Modular Aritmathic2.py","extension":".py","language":"python","size":39,"content":"print (pow(273246787654, 65536, 65537))","contentHash":"sha256:abcbe6fb11f02d1de9be99f49100955a66b9427bad29afbd548e4f3d9d99a976"},{"name":"Modular inverting.py","path":"CyberSecurity/Cryptography/Modular Aritmathic/praktek/Modular inverting.py","extension":".py","language":"python","size":22,"content":"print (pow(3, -1, 13))","contentHash":"sha256:c13e791e23eb73e6d14aa8089045d27ce8696c2bd82298e7f0b2359d822fe4dd"},{"name":"Quadratic Residue.py","path":"CyberSecurity/Cryptography/Modular Aritmathic/praktek/Quadratic Residue.py","extension":".py","language":"python","size":79,"content":"p = 29\n\nfor a in range (p):\n    qr = pow(a, 2, p)\n    print(f\"a={a} : qr={qr}\")","contentHash":"sha256:65efc29ea6eddd65daaff49cb4f81c1011926e2736b089c08c8633a4fa5c6d07"},{"name":"Simple Tonelli-Shanks.py","path":"CyberSecurity/Cryptography/Modular Aritmathic/praktek/Simple Tonelli-Shanks.py","extension":".py","language":"python","size":1522,"content":"from sympy.ntheory import sqrt_mod\n\na = \np = \n\nr1 = sqrt_mod(a, p)\n\nif r1 is not None:\n    r2 = p - r1\n    print(f\"Nilai R (Akar 1): {r1}\")\n    print(f\"Nilai p - R (Akar 2): {r2}\")\n    print(f\"Akar paling kecil: {min(r1, r2)}\")\nelse:\n    print(\"a bukan sisa kuadrat (tidak memiliki akar)\")","contentHash":"sha256:18cb9db9969dc4c261afcb487039ed8aa7e1561847b7c3897c9b16e72260f9de"},{"name":"Tonelli-Shanks.py","path":"CyberSecurity/Cryptography/Modular Aritmathic/praktek/Tonelli-Shanks.py","extension":".py","language":"python","size":2929,"content":"a = \np = \np1 = p-1\n\n# step 1 : Faktorisasi Bagian Genap dari (p - 1)\n# Menjadikan Bilangan Genap\nq = p\nq -= 1\n\n# Mencari S dan Q\ns = 0\nwhile q %2 == 0:\n    q = q // 2\n    s +=1\n\n# Step 2 Cari Z^p-2/1 = -1 (mod p) dan c = z^Q mod p\nfor z in range(2, p):\n    if pow(z, (p - 1) // 2, p) == p - 1:  # p - 1 itu sama dengan -1 mod p\n        print(f\"Nilai z yang ditemukan: {z}\")\n        break \nc = pow(z, q, p)\n\n# step 3 Inisialisasi Variabel Pelacak\nR = pow(a, (q + 1) // 2, p)\nt = pow (a, q, p)\nm = s\n\n# Step 4: Perulangan (Looping) untuk Memperbaiki Nilai\nif t == 1:\n    print(f\"Nilai R: {R}\")\nelif t == 0:\n    print(\"Akarnya adalah 0\")\nelse:\n    # Masuk ke perulangan utama selama t tidak sama dengan 1\n    while t != 1:\n        # Step 4a: Cari Nilai i terkecil (0 < i < m) sedemikian rupa t^(2^i) == 1 mod p\n        i = 0\n        faktor_t = t\n        # Lakukan perulangan untuk mengkuadratkan t secara berturut-turut\n        while faktor_t != 1 and i < m:\n            i += 1\n            faktor_t = pow(faktor_t, 2, p)\n\n        # Jika i sama dengan m, berarti 'a' bukan sisa kuadrat (tidak ada akar)\n        if i == m:\n            print(\"a bukan sisa kuadrat (tidak memiliki akar kuadrat modular)\")\n            break\n\n        # Step 4b: Hitung Nilai b\n        # Menggunakan 2 ** (m - i - 1) sebagai eksponen langsung\n        pangkat_b = 2 ** (m - i - 1)\n        b = pow(c, pangkat_b, p)\n\n        # Step 4c: Perbaiki Nilai R, t, c, dan m\n        R = (R * b) % p\n        t = (t * pow(b, 2, p)) % p\n        c = pow(b, 2, p)\n        m = i\n\n    # Cetak hasil jika loop selesai dengan sukses (t == 1)\n    if t == 1:\n        print(f\"Nilai R (Akar 1): {R}\")\n        print(f\"Nilai p - R (Akar 2): {p - R}\")","contentHash":"sha256:8b37e389d540c78c98eda472765c2fa12681aac1d74fe8ea855c0a143590b106"}]}