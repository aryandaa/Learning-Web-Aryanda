{"schemaVersion":1,"type":"code-folder","folder":"Form","path":"Pemrograman/JavaScript/Javascript For Frontend/praktek/Form","parentPath":"Pemrograman/JavaScript/Javascript For Frontend/praktek","outputPath":"code/Pemrograman/JavaScript/Javascript For Frontend/praktek/Form","files":[{"name":"index.html","path":"Pemrograman/JavaScript/Javascript For Frontend/praktek/Form/index.html","extension":".html","language":"html","size":1438,"content":"<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Form World</title>\n    <link rel=\"stylesheet\" href=\"styles.css\" />\n</head>\n<body>\n    <div class=\"contents\">\n        <h2 align=\"center\">Isi data diri</h2>\n\n        <div class=\"formContent\">\n            <form id=\"formDataDiri\">\n                <div class=\"form-element\">\n                    <label for=\"inputNama\">Nama:</label><br />\n                    <input \n                        type=\"text\" \n                        id=\"inputNama\" \n                        name=\"nama\" \n                        placeholder=\"Nama Anda\" \n                        required \n                    /><br />\n                </div>\n\n                <div class=\"form-element\">\n                    <label for=\"inputDomisili\">Domisili:</label><br />\n                    <input\n                        type=\"text\"\n                        id=\"inputDomisili\"\n                        name=\"domisili\"\n                        placeholder=\"Domisili Anda\"\n                        required\n                    /><br />\n                </div>\n\n                <div class=\"form-element\">\n                    <input type=\"submit\" value=\"Submit Data\" />\n                </div>\n            </form>\n        </div>\n\n        <h3 id=\"messageAfterSubmit\"></h3>\n    </div>\n\n    <script src=\"index.js\"></script>\n</body>\n</html>","contentHash":"sha256:9b8bcb54610ea0c3ab0878edbe243355c3208fa86ac2d5e3f72452c294f43dfa"},{"name":"index.js","path":"Pemrograman/JavaScript/Javascript For Frontend/praktek/Form/index.js","extension":".js","language":"javascript","size":458,"content":"const submitAction = document.getElementById('formDataDiri');\n\nsubmitAction.addEventListener('submit', function(event){\n    const inputNama = document.getElementById('inputNama').value;\n    const inputDomisili = document.getElementById('inputDomisili').value;\n    const hiddenMessage = `Halo, ${inputNama}. Bagaimana cuacanya di ${inputDomisili}?`;\n\n    document.getElementById('messageAfterSubmit').innerText = hiddenMessage;\n    event.preventDefault();\n\n})","contentHash":"sha256:7a6868949a265565742113c8e6143e6cf823b507458502b44c4ec795b467b41b"},{"name":"styles.css","path":"Pemrograman/JavaScript/Javascript For Frontend/praktek/Form/styles.css","extension":".css","language":"css","size":149,"content":".contents {\n    border: 2px solid black;\n    padding: 15px;\n    position: fixed;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n}","contentHash":"sha256:4fb0f014cb10aefe081f4149129467233d6e9dd8cf281e6f034241f83e3b8251"}]}